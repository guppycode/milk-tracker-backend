<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	
	<!-- Keep Spring Boot parent for dependency management -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
	</parent>
	
	<groupId>com.guppycode</groupId>
	<artifactId>guppycode-core-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	
	<name>guppycode-core-backend</name>
	
	<properties>
		<maven-surefire-plugin-version>3.2.5</maven-surefire-plugin-version>
		<java.version>25</java.version>
		<lombok.version>1.18.44</lombok.version>
		<spring-modulith.version>1.4.4</spring-modulith.version>
		<archunit.version>1.4.1</archunit.version>
	</properties>

	<modules>
		<module>guppycode-core-showcase</module>
		<module>guppycode-core-commons</module>
		<module>guppycode-core-security</module>
		<module>guppycode-core-audit</module>
		<module>guppycode-core-api</module>
		<module>guppycode-core-starter</module>
	</modules>

	<!-- Dependency management only, no real dependencies here -->
	<dependencyManagement>
		<dependencies>

			<!-- Centralized Lombok version -->
			<dependency>
				<groupId>org.projectlombok</groupId>
				<artifactId>lombok</artifactId>
				<version>${lombok.version}</version>
			</dependency>

			<!-- Spring Modulith BOM (centralized version for all modulith artifacts) -->
			<dependency>
				<groupId>org.springframework.modulith</groupId>
				<artifactId>spring-modulith-bom</artifactId>
				<version>${spring-modulith.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- ArchUnit (centralized version for all architecture tests) -->
			<dependency>
				<groupId>com.tngtech.archunit</groupId>
				<artifactId>archunit-junit5</artifactId>
				<version>${archunit.version}</version>
				<scope>test</scope>
			</dependency>

		</dependencies>
	</dependencyManagement>
	
	<build>
		<pluginManagement>
			<plugins>
				
				<!-- Compiler plugin with Lombok annotation processor -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
								<version>${lombok.version}</version>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>
				
				<!-- Surefire plugin (needed for JUnit 5 + module path issues) -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<configuration>
						<useModulePath>false</useModulePath>
					</configuration>
				</plugin>
				
				<!-- Spring Boot plugin (exclude Lombok from final fat JAR) -->
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
					<configuration>
						<excludes>
							<exclude>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
							</exclude>
						</excludes>
					</configuration>
				</plugin>
				
			</plugins>
		</pluginManagement>
	</build>
	
	<organization>
	    <name>Guppy Code</name>
	    <url>https://github.com/guppycode</url>
	</organization>
	
	<scm>
	    <connection>scm:git:git://github.com/guppycode/guppycode-core-backend.git</connection>
	    <developerConnection>scm:git:ssh://git@github.com:guppycode/guppycode-core-backend.git</developerConnection>
	    <url>https://github.com/guppycode/guppycode-core-backend</url>
	    <tag>HEAD</tag>
	</scm>
	
	<issueManagement>
	    <system>GitHub Issues</system>
	    <url>https://github.com/guppycode/guppycode-core-backend/issues</url>
	</issueManagement>
	
	<ciManagement>
	    <system>GitHub Actions</system>
	    <url>https://github.com/guppycode/guppycode-core-backend/actions</url>
	</ciManagement>
	
	<description>GuppyCode Core Backend is a set of reusable backend modules for Spring Boot projects.
You can use each module independently or simply include the guppycode-core-starter, which already bundles and configures everything to avoid dependency issues.</description>
</project>
