<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.guppycode</groupId>
        <artifactId>guppycode-core-backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>guppycode-core-security</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!-- Spring Security runtime used by the core security module -->
	    <dependency>
	        <groupId>org.springframework.boot</groupId>
	        <artifactId>spring-boot-starter-security</artifactId>
	    </dependency>
	
	    <!-- OAuth2 resource server support for JWT-based authentication -->
	    <dependency>
	        <groupId>org.springframework.boot</groupId>
	        <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
	    </dependency>
	
	    <!--
	        Identity-provider integration note:
	        guppycode-core-security is identity-provider-agnostic and does not provide
	        user, role, or permission persistence.
	
	        Applications that need a database-backed user store should provide their own
	        Spring Security beans, or use a dedicated optional module such as
	        guppycode-core-security-jpa if one is introduced in the future.
	    -->
	
	    <!-- Test support for Spring Security configuration and application contexts -->
	    <dependency>
	        <groupId>org.springframework.boot</groupId>
	        <artifactId>spring-boot-starter-test</artifactId>
	        <scope>test</scope>
	    </dependency>
	
	    <!-- Generates metadata for type-safe configuration properties -->
	    <dependency>
	        <groupId>org.springframework.boot</groupId>
	        <artifactId>spring-boot-configuration-processor</artifactId>
	        <optional>true</optional>
	    </dependency>
	
	    <!-- Architecture and modularity verification tests -->
	    <dependency>
	        <groupId>com.tngtech.archunit</groupId>
	        <artifactId>archunit-junit5</artifactId>
	        <scope>test</scope>
	    </dependency>
	
	    <!-- Servlet API implementation provided by the consuming application at runtime -->
	    <dependency>
		    <groupId>jakarta.servlet</groupId>
		    <artifactId>jakarta.servlet-api</artifactId>
		    <scope>provided</scope>
		</dependency>
	
	    <!-- Shared GuppyCode Core abstractions, exceptions, and utilities -->
	    <dependency>
	        <groupId>com.guppycode</groupId>
	        <artifactId>guppycode-core-commons</artifactId>
	        <version>${project.version}</version>
	    </dependency>
	
	    <!-- Lombok is used only during compilation and is not exposed transitively to consumers -->
	    <dependency>
	        <groupId>org.projectlombok</groupId>
	        <artifactId>lombok</artifactId>
	        <scope>provided</scope>
	        <optional>true</optional>
	    </dependency>
    </dependencies>
    
    <build>
	    <plugins>
	        <plugin>
	            <groupId>org.apache.maven.plugins</groupId>
	            <artifactId>maven-surefire-plugin</artifactId>
	            <configuration>
	                <useModulePath>false</useModulePath>
	            </configuration>
	        </plugin>
	    </plugins>
	</build>
</project>
